---
const { name } = Astro.props
---

<svg class="feature-icon" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'keyboard' && <><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M6 10h.01M9 10h.01M12 10h.01M15 10h.01M18 10h.01M7 14h10" /></>}
  {name === 'wave' && <path d="M3 12h2l2-5 3 10 3-10 2 5h6" />}
  {name === 'capture' && <><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" /><path d="m8 12 3 3 5-6" /></>}
  {name === 'pen' && <><path d="m4 20 4.5-1L19 8.5a2.12 2.12 0 0 0-3-3L5.5 16 4 20Z" /><path d="m14.5 7.5 2 2" /></>}
  {name === 'bolt' && <path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z" />}
  {name === 'spark' && <><path d="m12 2 1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2Z" /><path d="m19 16 .6 2.4L22 19l-2.4.6L19 22l-.6-2.4L16 19l2.4-.6L19 16Z" /></>}
</svg>

<style>
  .feature-icon { fill: none; height: 24px; stroke: #d7f96a; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; width: 24px; }
</style>
