---
interface Props { title: string; description: string; path?: string }
const { title, description, path = '' } = Astro.props
const canonical = `https://alat.cc/products/mood/${path}`
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
<title>{title} — Mood · alat</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:title" content={`${title} — Mood`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
</head>
<body>
<header><a href="/" class="brand">alat<span>.</span></a><a href="/products/mood/">Mood</a></header>
<main><slot /></main>
<footer><a href="/products/mood/">Mood</a><a href="/products/mood/privacy-policy/">Kebijakan privasi</a><a href="/products/mood/delete-account/">Hapus akun & data</a><a href="mailto:azzam@alat.cc">Hubungi kami</a></footer>
</body>
</html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#fff9ef;color:#173f37;font:17px/1.75 system-ui,-apple-system,sans-serif}header,main,footer{width:min(820px,calc(100% - 40px));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid #d8dfd5}a{color:#126452;text-underline-offset:4px}a:hover{color:#923e28}.brand{font-weight:800;font-size:27px;text-decoration:none}.brand span{color:#6d997d}main{padding:64px 0 80px}h1{font-size:clamp(38px,7vw,64px);line-height:1.1;letter-spacing:-.045em;margin:18px 0 24px}h2{font-size:26px;line-height:1.3;margin:0 0 16px}h3{font-size:20px}p{margin:0 0 18px}section{padding-top:28px;margin-top:36px;border-top:1px solid #d8dfd5}.eyebrow{font-size:13px;letter-spacing:.12em;text-transform:uppercase}.lead{font-size:22px;max-width:650px}.muted{color:#51685f}.notice{padding:22px;background:#e1efdf;border-radius:22px}.cta{display:inline-block;background:#246b59;color:#fff;padding:14px 24px;border-radius:32px;text-decoration:none;font-weight:650}.cta:hover{background:#184e40;color:#fff}li{margin-bottom:12px}footer{display:flex;flex-wrap:wrap;gap:14px 24px;padding:28px 0;border-top:1px solid #d8dfd5;font-size:14px}.hero-icon{width:120px;height:120px;object-fit:contain}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.features article{padding:12px 0}.feature-mark{font-size:30px}small{font-size:14px}@media(max-width:600px){main{padding-top:40px}.features{grid-template-columns:1fr;gap:12px}.lead{font-size:20px}footer{flex-direction:column;gap:12px}}
</style>
