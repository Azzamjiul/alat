---
import { products } from '../data/products'

const toolCount = products.length.toString().padStart(2, '0')
const canonicalUrl = 'https://alat.cc/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="A small collection of focused tools for everyday work."
    />
    <meta property="og:site_name" content="alat" />
    <meta property="og:title" content="alat — useful tools, quietly made" />
    <meta property="og:description" content="A small collection of focused tools for everyday work." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://alat.cc/og/index.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="alat — useful tools, quietly made" />
    <meta name="twitter:description" content="A small collection of focused tools for everyday work." />
    <meta name="twitter:image" content="https://alat.cc/og/index.png" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'alat',
      url: canonicalUrl,
      description: 'A small collection of focused tools for everyday work.',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: products.map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product.name, url: `https://alat.cc/products/${product.slug}/` })),
    })} />
    <title>alat — useful tools, quietly made</title>
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="alat home">alat<span>.</span></a>
      <span class="header-note">a small software shelf</span>
    </header>

    <main>
      <section class="hero shell">
        <p class="eyebrow"><span></span> independent tools</p>
        <h1>Small tools.<br /><em>Useful by default.</em></h1>
        <p class="intro">
          A growing collection of focused software for thinking, making, and
          getting things done.
        </p>
        <a class="scroll-cue" href="#tools">↓ <span>browse the shelf</span></a>
      </section>

      <section class="tools-section shell" id="tools">
        <div class="section-heading">
          <p class="eyebrow"><span></span> the collection</p>
          <p class="section-count">{toolCount} tools / and counting</p>
        </div>
        <div class="tool-grid">
          {products.map((tool, index) => (
            <a class={`tool-card card-${index + 1}`} href={`/products/${tool.slug}/`}>
              <div class="card-topline">
                {tool.iconSrc ? <img class="card-logo" src={tool.iconSrc} alt="" /> : <span class="card-mark">{tool.mark}</span>}
                <span class="card-kind">{tool.kind}</span>
              </div>
              <div>
                <h2>{tool.name}</h2>
                <p>{tool.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="footer-note shell">
        <p>Made for the parts of the day that deserve a little less friction.</p>
        <span>alat.cc / 2026</span>
      </section>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #151613;
    color: #f1efe7;
    font-family: 'Manrope', sans-serif;
  }
  :global(a) { color: inherit; text-decoration: none; }
  .shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    padding: 30px 0;
  }
  .wordmark { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.08em; }
  .wordmark span, .eyebrow span { color: #d7f96a; }
  .header-note, .section-count, .card-kind, .footer-note span {
    color: #85867c;
    font: 0.68rem 'DM Mono', monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero { min-height: 500px; padding: 48px 0 64px; }
  .eyebrow {
    color: #d7f96a;
    font: 0.68rem 'DM Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .eyebrow span { display: inline-block; margin-right: 9px; }
  h1 {
    font-size: clamp(3.5rem, 9vw, 8rem);
    letter-spacing: -0.09em;
    line-height: 0.91;
    margin: 28px 0 34px;
    max-width: none;
  }
  h1 em { color: #d7f96a; font-style: normal; white-space: nowrap; }
  .intro { color: #aaa9a0; font-size: 1rem; line-height: 1.7; max-width: 350px; }
  .scroll-cue {
    align-items: center;
    color: #d7f96a;
    display: flex;
    gap: 12px;
    margin-top: 56px;
  }
  .scroll-cue span { color: #85867c; font: 0.68rem 'DM Mono', monospace; text-transform: uppercase; }
  .section-heading { align-items: baseline; border-top: 1px solid #373832; display: flex; justify-content: space-between; padding-top: 18px; }
  .tool-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); margin-top: 25px; }
  .tool-card { background: #20211d; cursor: pointer; display: flex; flex-direction: column; min-height: 280px; padding: 24px; transition: transform 180ms ease, background 180ms ease; }
  .tool-card:hover { background: #292b24; transform: translateY(-5px); }
  .card-2 { background: #d7f96a; color: #151613; }
  .card-2:hover { background: #e1ff82; }
  .card-topline { align-items: center; display: flex; justify-content: space-between; }
  .card-logo { filter: invert(1); height: 30px; object-fit: cover; width: 30px; }
  .card-2 .card-logo { filter: none; }
  .card-mark { align-items: center; border: 1px solid currentColor; display: grid; font: 0.7rem 'DM Mono', monospace; height: 30px; place-items: center; width: 30px; }
  .card-kind { color: #85867c; }
  .card-2 .card-kind { color: #555b3b; }
  h2 { font-size: 2rem; letter-spacing: -0.07em; margin: 24px 0 10px; }
  .tool-card p { color: #aaa9a0; font-size: 0.9rem; line-height: 1.5; margin: 0; }
  .card-2 p { color: #555b3b; }
  .footer-note { align-items: end; border-top: 1px solid #373832; display: flex; justify-content: space-between; margin-top: 150px; padding: 22px 0 34px; }
  .footer-note p { color: #85867c; font-size: 0.78rem; margin: 0; }
  @media (max-width: 700px) {
    .shell { width: min(100% - 32px, 1120px); }
    .header-note { display: none; }
    .hero { min-height: 500px; padding-top: 64px; }
    .tool-grid { grid-template-columns: 1fr; }
    .tool-card { min-height: 250px; }
    h1 em { white-space: normal; }
    .footer-note { align-items: start; flex-direction: column; gap: 18px; margin-top: 100px; }
  }
</style>
