---
import { products } from '../../data/products'
import FeatureIcon from '../../components/FeatureIcon.astro'
import GoogleAnalytics from '../../components/GoogleAnalytics.astro'

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
const canonicalUrl = `https://alat.cc/products/${product.slug}/`
const ogImage = `https://alat.cc/og/${product.slug}.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={product.description} />
    <meta property="og:site_name" content="alat" />
    <meta property="og:title" content={`${product.name} — alat`} />
    <meta property="og:description" content={product.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${product.name} — alat`} />
    <meta name="twitter:description" content={product.description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: product.name,
        applicationCategory: 'UtilitiesApplication',
        operatingSystem: product.kind.replace(' app', ''),
        description: product.description,
        url: canonicalUrl,
      })}
    />
    <title>{product.name} — alat</title>
    <GoogleAnalytics />
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="alat home">alat<span>.</span></a>
      <a class="back-link" href="/">← all tools</a>
    </header>

    <main class="shell product-page">
      <div class="product-hero">
        <div class="product-copy">
          <p class="eyebrow"><span></span> {product.kind}</p>
          <div class="product-heading">
            {product.iconSrc ? <img class="product-logo" src={product.iconSrc} alt="" /> : <div class="product-mark">{product.mark}</div>}
            <h1>{product.name}</h1>
          </div>
          <p class="tagline">{product.tagline}</p>
          <p class="description">{product.description}</p>
          <div class="actions">
            <div class="download-actions">
              {product.downloadHref && <a class="primary-download" href={product.downloadHref} download><span class="download-label">{product.kind.includes('macOS') && <svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" /></svg>}<span>{product.downloadLabel}</span></span><b>↓</b></a>}
              {product.slug === 'ujer' && <button class="primary-download android-download" type="button" disabled><span class="download-label"><svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z" /></svg><span>Download for Android</span></span><small>coming soon</small></button>}
              {!product.kind.includes('macOS') && <a class="secondary-link" href={product.appHref}>open {product.name} <b>↗</b></a>}
            </div>
            {product.slug === 'ujer' && <a class="privacy-link" href="/products/ujer/privacy-policy/">privacy policy <b>↗</b></a>}
          </div>
        </div>

        {product.kind.includes('macOS') && (
          <button class={`demo-stage demo-${product.slug}`} data-demo type="button" aria-label={`Play ${product.name} demo`}>
            <img class="demo-poster" src={`/demos/${product.slug}-poster.png`} alt={`${product.name} demo preview`} />
            <video class="demo-video" data-video data-src={`/demos/${product.slug}-demo.mp4`} muted playsinline loop preload="none" aria-label={`${product.name} animated demo`}></video>
            <span class="demo-hint" aria-hidden="true"><span class="play-icon">▶</span></span>
          </button>
        )}
      </div>

      <section class="details">
        <p class="eyebrow"><span></span> what it does</p>
        <ul>
          {product.features.map((feature) => (
            <li>
              <FeatureIcon name={feature.icon} />
              <strong>{feature.title}</strong>
              <span>{feature.description}</span>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="shell footer-note">
      <p>Useful software, quietly made.</p>
      <span>alat.cc / 2026</span>
    </footer>
  </body>
</html>

<script>
  document.querySelectorAll('[data-demo]').forEach((stage) => {
    const video = stage.querySelector('[data-video]')
    stage.addEventListener('click', () => {
      if (stage.classList.contains('is-playing')) {
        video.pause()
        video.removeAttribute('src')
        video.load()
        stage.classList.remove('is-playing')
        stage.setAttribute('aria-label', stage.getAttribute('aria-label').replace('Pause', 'Play'))
        return
      }
      video.src = video.dataset.src
      video.load()
      video.play()
      stage.classList.add('is-playing')
      stage.setAttribute('aria-label', stage.getAttribute('aria-label').replace('Play', 'Pause'))
    })
  })
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #151613; color: #f1efe7; font-family: 'Manrope', sans-serif; margin: 0; }
  :global(a) { color: inherit; text-decoration: none; }
  .shell { margin: 0 auto; width: min(1120px, calc(100% - 48px)); }
  .site-header { align-items: center; display: flex; justify-content: space-between; padding: 30px 0; }
  .wordmark { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.08em; }
  .wordmark span, .eyebrow span { color: #d7f96a; }
  .back-link, .eyebrow, .footer-note span { color: #85867c; font: 0.68rem 'DM Mono', monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .back-link:hover { color: #d7f96a; }
  .product-page { padding: 72px 0 120px; width: min(1440px, calc(100% - 48px)); }
  .eyebrow { color: #d7f96a; }
  .eyebrow span { display: inline-block; margin-right: 9px; }
  .product-hero { min-height: 0; text-align: center; }
  .product-copy { margin: 0 auto; max-width: 820px; }
  .product-heading { align-items: center; display: flex; gap: 20px; justify-content: center; margin-top: 26px; }
  .product-logo { filter: invert(1); height: 96px; object-fit: cover; width: 96px; }
  .product-mark { align-items: center; border: 1px solid #d7f96a; color: #d7f96a; display: grid; font: 1rem 'DM Mono', monospace; height: 64px; place-items: center; width: 64px; }
  h1 { font-size: clamp(4rem, 10vw, 8.5rem); letter-spacing: -0.1em; line-height: 0.9; margin: 0; }
  .tagline { color: #d7f96a; font-size: clamp(1.6rem, 3vw, 2.5rem); letter-spacing: -0.06em; margin: 42px 0 18px; }
  .description { color: #aaa9a0; font-size: 1rem; line-height: 1.7; margin: 0 auto; max-width: 520px; }
  .primary-download { align-items: center; background: #d7f96a; color: #151613; display: inline-flex; font: 0.75rem 'DM Mono', monospace; gap: 22px; justify-content: space-between; min-width: 250px; padding: 16px 18px; text-transform: uppercase; }
  .primary-download:hover { background: #e1ff82; }
  .primary-download b { font-size: 1rem; margin-left: 7px; }
  .download-label { align-items: center; display: inline-flex; gap: 12px; }
  .platform-icon { flex: 0 0 auto; height: 19px; width: 19px; }
  .android-download { background: #20211d; border: 1px solid #41443a; color: #85867c; cursor: not-allowed; }
  .android-download small { color: #85867c; font: 0.58rem 'DM Mono', monospace; letter-spacing: 0.06em; }
  .android-download:hover { background: #20211d; }
  .actions { align-items: center; display: flex; flex-direction: column; gap: 18px; justify-content: center; margin-top: 28px; }
  .download-actions { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .secondary-link { border-bottom: 1px solid #85867c; color: #aaa9a0; font: 0.68rem 'DM Mono', monospace; padding-bottom: 8px; text-transform: uppercase; }
  .secondary-link:hover { border-color: #d7f96a; color: #d7f96a; }
  .privacy-link { align-items: center; border: 1px solid #41443a; color: #aaa9a0; display: inline-flex; font: 0.68rem 'DM Mono', monospace; gap: 12px; padding: 12px 15px; text-transform: uppercase; transition: background 180ms ease, border-color 180ms ease, color 180ms ease; }
  .privacy-link b { color: #d7f96a; font-size: 0.9rem; }
  .privacy-link:hover { background: #20211d; border-color: #d7f96a; color: #d7f96a; }
  .demo-stage { appearance: none; background: #20211d; border: 1px solid #41443a; box-shadow: 0 24px 60px #0005; cursor: pointer; display: block; margin: 92px auto 0; max-width: 1120px; overflow: hidden; padding: 0; position: relative; text-align: initial; width: 100%; }
  .demo-poster, .demo-video { display: block; width: 100%; }
  .demo-video { height: 100%; inset: 0; object-fit: cover; opacity: 0; position: absolute; transition: opacity 400ms ease; }
  .demo-stage.is-playing .demo-video { opacity: 1; }
  .demo-hint { align-items: center; background: #151613dd; border: 1px solid #d7f96a; border-radius: 50%; color: #d7f96a; display: flex; height: 64px; justify-content: center; left: 50%; pointer-events: none; position: absolute; top: 50%; transform: translate(-50%, -50%); transition: opacity 250ms ease, transform 250ms ease; width: 64px; }
  .play-icon { font-size: 1.15rem; margin-left: 4px; }
  .demo-stage.is-playing .demo-hint { opacity: 0; }
  .details { border-top: 1px solid #373832; margin-top: 130px; padding-top: 20px; }
  ul { display: grid; gap: 12px; grid-template-columns: repeat(3, 1fr); list-style: none; margin: 34px 0 0; padding: 0; }
  li { background: #20211d; color: #aaa9a0; display: flex; flex-direction: column; gap: 10px; min-height: 155px; padding: 22px; }
  li:nth-child(2) .feature-icon { animation: float 2.8s ease-in-out infinite; }
  li strong { color: #f1efe7; font-size: 1rem; letter-spacing: -0.03em; margin-top: auto; }
  li span { font-size: 0.78rem; line-height: 1.45; }
  @keyframes float { 50% { transform: translateY(-3px); } }
  .footer-note { align-items: end; border-top: 1px solid #373832; display: flex; justify-content: space-between; padding: 22px 0 34px; }
  .footer-note p { color: #85867c; font-size: 0.78rem; margin: 0; }
  @media (max-width: 700px) {
    .shell { width: min(100% - 32px, 1120px); }
    .product-page { padding-top: 72px; width: min(100% - 32px, 1120px); }
    .product-hero { display: block; min-height: 0; }
    .product-heading { gap: 16px; }
    .product-logo { height: 72px; width: 72px; }
    h1 { font-size: clamp(3.5rem, 18vw, 5.5rem); }
    .tagline { margin-top: 58px; }
    .download-actions { align-items: stretch; flex-direction: column; width: 100%; }
    .primary-download { width: 100%; }
    .demo-stage { margin-top: 64px; }
    .details { margin-top: 90px; }
    ul { grid-template-columns: 1fr; }
    .footer-note { align-items: start; flex-direction: column; gap: 18px; }
  }
</style>
